# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Both values are safe to expose in a browser
# bundle: the anon key is protected by the RLS policies in supabase/schema.sql.
#
# Leave them unset to run in local-only mode — everything works except
# verifying a certificate from a second device.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
